# Copy to .env and fill in. .env is git-ignored. Every key is optional:
# a channel without its key is skipped and the skip is recorded in out/run_log.md.

# Contact email sent in the User-Agent header of every request.
RADAR_CONTACT_EMAIL=sethnrosenberg@gmail.com

# USAJobs (free, instant): https://developer.usajobs.gov/APIRequest/Index
# USAJOBS_EMAIL must be the address you registered the key with.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Adzuna (free tier): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SerpAPI Google Jobs (100 free searches/month): https://serpapi.com/
SERPAPI_KEY=

# Hosts whose robots.txt blanket-disallows automated access but which publish
# a documented API for programmatic use. Comma-separated. Leave empty to honor
# robots.txt everywhere (default). Example: index.commoncrawl.org
RADAR_ROBOTS_EXEMPT_HOSTS=

# Cache lifetime for HTTP responses, in hours. Weekly runs always refetch.
RADAR_CACHE_TTL_HOURS=20

# Optional digest of new fit rows after each refresh.
# ntfy.sh: pick an unguessable topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
# SMTP (e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
